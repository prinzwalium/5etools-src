<!DOCTYPE html>
<html lang="en">

{{> "head" }}

<body>

{{> "overlayNoise" }}

{{> "adLeaderboard" }}

{{> "navbar" }}

{{> "adLhsScrollingPage" }}
{{> "adRhsScrollingPage" }}

<main class="container" data-cancer-id="cancer-wrapper">
	<div class="cs__toolbar ve-flex-v-center ve-flex-wrap ve-mb-2 no-print">
		<select id="cs-char-select" class="ve-form-control ve-input-xs cs__char-select no-print" title="Switch character" style="max-width: 200px; display: inline-block; width: auto;"></select>
		<button class="ve-btn ve-btn-sm ve-btn-default" id="cs-char-new" type="button" title="New character"><span class="glyphicon glyphicon-plus"></span></button>
		<button class="ve-btn ve-btn-sm ve-btn-danger" id="cs-char-delete" type="button" title="Delete the current character"><span class="glyphicon glyphicon-trash"></span></button>
		<button class="ve-btn ve-btn-sm ve-btn-primary" id="cs-btn-wizard" type="button" title="Create a character step-by-step"><span class="glyphicon glyphicon-list-alt"></span> Guided Setup</button>
		<button class="ve-btn ve-btn-sm ve-btn-default" id="cs-btn-save" type="button" title="Save the current character to a file"><span class="glyphicon glyphicon-download"></span> Save to File</button>
		<button class="ve-btn ve-btn-sm ve-btn-default" id="cs-btn-load" type="button" title="Load a character from a file"><span class="glyphicon glyphicon-upload"></span> Load from File</button>
		<button class="ve-btn ve-btn-sm ve-btn-default" id="cs-btn-print" type="button" title="Print, or save as PDF"><span class="glyphicon glyphicon-print"></span> Print</button>
		<button class="ve-btn ve-btn-sm ve-btn-default" id="cs-btn-cards" type="button" title="Print this character's spells and attacks as reference cards"><span class="glyphicon glyphicon-th-large"></span> Cards</button>
		<button class="ve-btn ve-btn-sm ve-btn-danger" id="cs-btn-reset" type="button" title="Clear the sheet"><span class="glyphicon glyphicon-refresh"></span> Reset</button>
			<button class="ve-btn ve-btn-sm ve-btn-default" id="cs-btn-homebrew" type="button" title="Add or remove homebrew; brew content then appears in every picker on this page"><span class="glyphicon glyphicon-folder-open"></span> Homebrew</button>
		<a href="charbuilder.html" class="ve-btn ve-btn-sm ve-btn-default ve-ml-auto" title="Open the build-focused character builder"><span class="glyphicon glyphicon-list-alt"></span> Open Builder</a>
	</div>

	<div class="cs__toolbar-note ve-muted ve-small ve-mb-2 no-print">Play your character here. Switch to the <a href="charbuilder.html">Builder</a> to level up or make changes. Everything is saved automatically in this browser.</div>

	<form id="charsheet" autocomplete="off">
		<div class="cs__hdr row ve-flex">
			<div class="ve-col-4 cs__hdr-name">
				<label class="cs__lbl" for="cs-name">Character Name</label>
				<input type="text" id="cs-name" class="ve-form-control cs__ipt-name" placeholder="Character Name">
			</div>
			<div class="ve-col-8">
				<div class="cs__hdr-grid">
					<div class="cs__field">
						<label class="cs__lbl" for="cs-classlevel">Class &amp; Level</label> <span class="cs__pick-link" id="cs-link-class"></span>
						<div class="cs__pick-group">
							<input type="text" id="cs-classlevel" class="ve-form-control ve-input-xs" placeholder="e.g. Fighter 5">
							<button type="button" class="ve-btn ve-btn-xs ve-btn-default cs__pick-btn no-print" id="cs-pick-class" title="Choose a class from the data"><span class="glyphicon glyphicon-search"></span></button>
						</div>
					</div>
					<div class="cs__field">
						<label class="cs__lbl" for="cs-background">Background</label> <span class="cs__pick-link" id="cs-link-background"></span>
						<div class="cs__pick-group">
							<input type="text" id="cs-background" class="ve-form-control ve-input-xs" placeholder="e.g. Soldier">
							<button type="button" class="ve-btn ve-btn-xs ve-btn-default cs__pick-btn no-print" id="cs-pick-background" title="Choose a background from the data"><span class="glyphicon glyphicon-search"></span></button>
						</div>
					</div>
					<label class="cs__field"><span class="cs__lbl">Player Name</span><input type="text" id="cs-playername" class="ve-form-control ve-input-xs"></label>
					<div class="cs__field">
						<label class="cs__lbl" for="cs-species">Species</label> <span class="cs__pick-link" id="cs-link-species"></span>
						<div class="cs__pick-group">
							<input type="text" id="cs-species" class="ve-form-control ve-input-xs" placeholder="e.g. Human">
							<button type="button" class="ve-btn ve-btn-xs ve-btn-default cs__pick-btn no-print" id="cs-pick-species" title="Choose a species from the data"><span class="glyphicon glyphicon-search"></span></button>
						</div>
					</div>
					<label class="cs__field"><span class="cs__lbl">Alignment</span>
						<select id="cs-alignment" class="ve-form-control ve-input-xs">
							<option value="">&mdash;</option>
							<option value="Lawful Good">Lawful Good</option>
							<option value="Neutral Good">Neutral Good</option>
							<option value="Chaotic Good">Chaotic Good</option>
							<option value="Lawful Neutral">Lawful Neutral</option>
							<option value="True Neutral">True Neutral</option>
							<option value="Chaotic Neutral">Chaotic Neutral</option>
							<option value="Lawful Evil">Lawful Evil</option>
							<option value="Neutral Evil">Neutral Evil</option>
							<option value="Chaotic Evil">Chaotic Evil</option>
							<option value="Unaligned">Unaligned</option>
						</select>
					</label>
					<label class="cs__field"><span class="cs__lbl">Experience Points</span><input type="number" id="cs-xp" min="0" class="ve-form-control ve-input-xs"></label>
				</div>
			</div>
		</div>

		<hr>

		<div class="row ve-flex cs__body">
			<div class="ve-col-3 cs__col">
				<div class="cs__panel">
					<div class="cs__abilities" id="cs-abilities"><!-- populated by JS --></div>
					<div id="cs-ability-offers"><!-- populated by JS --></div>
				</div>

				<div class="cs__panel cs__panel--inline">
					<label class="cs__toggle ve-flex-v-center" title="Toggle inspiration">
						<input type="checkbox" id="cs-inspiration">
						<span class="cs__lbl cs__lbl--inline">Inspiration</span>
					</label>
				</div>

				<div class="cs__panel cs__panel--inline">
					<label class="cs__field cs__field--inline" title="Proficiency bonus is derived from your total level">
						<span class="cs__lbl">Level</span>
						<input type="number" id="cs-level" min="1" max="20" value="1" class="ve-form-control ve-input-xs cs__ipt-num">
					</label>
					<div class="cs__stat-badge" title="Proficiency Bonus (derived from level)">
						<span class="cs__stat-badge-val" id="cs-pb">+2</span>
						<span class="cs__lbl">Proficiency Bonus</span>
					</div>
				</div>

				<div class="cs__panel">
					<h5 class="cs__panel-title">Saving Throws</h5>
					<div class="cs__list" id="cs-saves"><!-- populated by JS --></div>
				</div>

				<div class="cs__panel">
					<h5 class="cs__panel-title">Skills</h5>
					<div class="cs__list" id="cs-skills"><!-- populated by JS --></div>
				</div>

				<div class="cs__panel cs__panel--inline">
					<div class="cs__stat-badge" title="10 + Wisdom (Perception) modifier">
						<span class="cs__stat-badge-val" id="cs-passive-perception">10</span>
						<span class="cs__lbl">Passive Wisdom (Perception)</span>
					</div>
				</div>

			</div>

			<div class="ve-col-5 cs__col">
				<div class="cs__panel">
					<div class="cs__combat-top">
						<div class="cs__field cs__field--boxed" title="Armor Class (computed from equipped armor/shield; switch mode for Unarmored Defense or a manual value)">
							<span class="cs__lbl">Armor Class</span>
							<div class="cs__ac-row ve-flex-v-center ve-flex-h-center">
								<span class="cs__stat-badge-val" id="cs-ac-computed">10</span>
								<input type="number" id="cs-ac" min="0" value="10" class="ve-form-control ve-input-xs cs__ipt-num cs__ac-manual ve-hidden" title="Manual AC value">
							</div>
							<select id="cs-ac-mode" class="ve-form-control ve-input-xs no-print cs__ac-mode" title="How Armor Class is calculated: from worn armor, from a Barbarian's or Monk's Unarmored Defense, or a number you set yourself">
								<option value="auto">From armor</option>
								<option value="barbarian">Unarmored (Barbarian)</option>
								<option value="monk">Unarmored (Monk)</option>
								<option value="manual">Set by hand</option>
							</select>
						</div>
						<div class="cs__field cs__field--boxed" title="1d20 + Dexterity modifier + misc">
							<span class="cs__lbl">Initiative</span>
							<div class="cs__combat-init">
								<span id="cs-initiative-roll" class="cs__roll">+0</span>
								<label class="cs__init-misc" title="Miscellaneous initiative bonus">+<input type="number" id="cs-init-misc" value="0" class="ve-form-control ve-input-xs cs__ipt-num cs__ipt-num--xs"></label>
							</div>
						</div>
						<label class="cs__field cs__field--boxed"><span class="cs__lbl">Speed</span><input type="text" id="cs-speed" value="30 ft." class="ve-form-control ve-input-xs"></label>
					</div>

					<div class="cs__hp">
						<div class="cs__hp-main">
							<div class="cs__hp-row">
								<label class="cs__field cs__field--boxed"><span class="cs__lbl">Current HP</span><input type="number" id="cs-hp-cur" value="0" class="ve-form-control ve-input-xs cs__ipt-num cs__ipt-num--hp"></label>
								<label class="cs__field cs__field--boxed"><span class="cs__lbl">Max HP</span><input type="number" id="cs-hp-max" min="0" value="0" class="ve-form-control ve-input-xs cs__ipt-num cs__ipt-num--hp"></label>
								<label class="cs__field cs__field--boxed"><span class="cs__lbl">Temp HP</span><input type="number" id="cs-hp-temp" value="0" class="ve-form-control ve-input-xs cs__ipt-num cs__ipt-num--hp"></label>
							</div>
							<div class="cs__hp-quick ve-flex-v-center ve-flex-wrap no-print">
								<label class="cs__field cs__field--inline ve-mb-0"><span class="cs__lbl">Adjust</span><input type="number" id="cs-hp-delta" value="0" class="ve-form-control ve-input-xs cs__ipt-num cs__ipt-num--xs"></label>
								<button type="button" id="cs-hp-damage" class="ve-btn ve-btn-xs ve-btn-danger" title="Subtract from current HP">Damage</button>
								<button type="button" id="cs-hp-heal" class="ve-btn ve-btn-xs ve-btn-success" title="Add to current HP">Heal</button>
							</div>
							<div class="cs__hp-rests ve-flex-v-center ve-flex-wrap no-print">
								<button type="button" id="cs-short-rest" class="ve-btn ve-btn-xs ve-btn-default" title="Restore Pact Magic slots">Short Rest</button>
								<button type="button" id="cs-long-rest" class="ve-btn ve-btn-xs ve-btn-primary" title="Restore HP, spell slots, Hit Dice; reduce Exhaustion">Long Rest</button>
								<label class="cs__field cs__field--inline cs__hp-policy ve-mb-0" title="How the level-up prompt gains HP">
									<span class="cs__lbl">On level-up</span>
									<select id="cs-hp-policy" class="ve-form-control ve-input-xs">
										<option value="ask">Ask each time</option>
										<option value="average">Average</option>
										<option value="max">Max</option>
										<option value="roll">Roll</option>
									</select>
								</label>
							</div>
						</div>
						<div class="cs__hp-side">
							<div class="cs__hd">
								<span class="cs__lbl">Hit Dice</span>
								<div class="cs__hd-row">
									<label class="cs__field"><span class="cs__lbl cs__lbl--sub">Remaining</span><input type="text" id="cs-hd-cur" placeholder="e.g. 5d10" class="ve-form-control ve-input-xs"></label>
									<label class="cs__field"><span class="cs__lbl cs__lbl--sub">Total</span><input type="text" id="cs-hd-total" placeholder="e.g. 5d10" class="ve-form-control ve-input-xs"></label>
								</div>
							</div>
							<div class="cs__death">
								<span class="cs__lbl">Death Saves</span>
								<div class="cs__death-row"><span class="cs__death-lbl">Successes</span><span class="cs__death-dots" id="cs-death-success" data-cs-max="3"></span></div>
								<div class="cs__death-row"><span class="cs__death-lbl">Failures</span><span class="cs__death-dots" id="cs-death-fail" data-cs-max="3"></span></div>
							</div>
						</div>
					</div>
				</div>

				<div class="cs__panel">
					<div class="cs__panel-title-row ve-flex-v-center ve-flex-h-between">
						<h5 class="cs__panel-title ve-mb-0">Attacks &amp; Spellcasting</h5>
						<div class="ve-flex-v-center no-print">
							<button type="button" id="cs-attack-add-weapon" class="ve-btn ve-btn-xs ve-btn-default ve-mr-2" title="Add a row from a weapon in the data"><span class="glyphicon glyphicon-search"></span> Add Weapon</button>
							<button type="button" id="cs-attack-add" class="ve-btn ve-btn-xs ve-btn-default" title="Add a blank row"><span class="glyphicon glyphicon-plus"></span> Add</button>
						</div>
					</div>
					<table class="cs__attacks w-100">
						<thead>
							<tr>
								<th>Name</th>
								<th class="ve-text-center">Atk Bonus</th>
								<th class="ve-text-center">Damage/Type</th>
								<th class="ve-text-center no-print"></th>
							</tr>
						</thead>
						<tbody id="cs-attacks-body"><!-- populated by JS --></tbody>
					</table>
					<div id="cs-unarmed" class="ve-small ve-mt-1" title="Always available"><!-- populated by JS --></div>
					<div id="cs-combat-notes" class="ve-small ve-mt-1"><!-- populated by JS --></div>
				</div>

				<div class="cs__panel" id="cs-spell-panel">
					<div class="cs__panel-title-row ve-flex-v-center ve-flex-h-between no-print">
						<span class="cs__lbl ve-mb-0" id="cs-title-spells">Spells</span>
						<div class="ve-flex-v-center no-print">
							<button type="button" id="cs-spell-browse" class="ve-btn ve-btn-xs ve-btn-primary ve-mr-2" title="Browse and manage this class's learnable spells"><span class="glyphicon glyphicon-book"></span> Class Spells</button>
							<button type="button" id="cs-spell-add" class="ve-btn ve-btn-xs ve-btn-default" title="Search and add any spell to the known/prepared list"><span class="glyphicon glyphicon-search"></span> Add Spell</button>
						</div>
					</div>
					<div id="cs-spell-body">
						<div class="cs__spellhdr">
							<label class="cs__field cs__field--inline">
								<span class="cs__lbl">Spellcasting Ability</span>
								<select id="cs-spell-ability" class="ve-form-control ve-input-xs">
									<option value="">&mdash;</option>
									<option value="int">Intelligence</option>
									<option value="wis">Wisdom</option>
									<option value="cha">Charisma</option>
								</select>
							</label>
							<div class="cs__stat-badge" title="8 + proficiency bonus + spellcasting ability modifier">
								<span class="cs__stat-badge-val" id="cs-spell-dc">&mdash;</span>
								<span class="cs__lbl">Spell Save DC</span>
							</div>
							<div class="cs__stat-badge" title="proficiency bonus + spellcasting ability modifier">
								<span class="cs__stat-badge-val cs__roll" id="cs-spell-atk">&mdash;</span>
								<span class="cs__lbl">Spell Attack Bonus</span>
							</div>
						</div>
						<div id="cs-spell-slots" class="ve-mt-1"><!-- populated by JS --></div>
						<div id="cs-spells-known" class="ve-mt-1"><!-- populated by JS --></div>
						<textarea id="cs-spells" aria-labelledby="cs-title-spells" class="ve-form-control cs__textarea cs__textarea--md" placeholder="Spell notes: rituals, foci, prepared lists..."></textarea>
					</div>
				</div>

				<div class="cs__panel">
					<h5 class="cs__panel-title" title="Derived from your weapons, spells (by casting time), and common features">Actions</h5>
					<div id="cs-actions"><!-- populated by JS --></div>
				</div>

				<!-- Not printed: a log of past sessions is not part of the sheet you play from -->
				<div class="cs__panel" id="cs-journal-panel">
					<h5 class="cs__panel-title" title="Written as you play: damage, healing, rests, spent slots, conditions and ammunition, grouped into sessions">Session Journal</h5>
					<div id="cs-journal"><!-- populated by JS --></div>
				</div>

				<div class="cs__panel">
					<h5 class="cs__panel-title">Conditions &amp; Concentration</h5>
					<label class="cs__field cs__field--inline ve-mb-1">
						<span class="cs__lbl">Concentrating on</span>
						<input type="text" id="cs-concentration" class="ve-form-control ve-input-xs" placeholder="e.g. Bless">
					</label>
					<div id="cs-conc-prompt" class="cs__conc-prompt ve-hidden no-print"><!-- populated by JS --></div>
					<label class="cs__field cs__field--inline ve-mb-1" title="0–6; a long rest reduces it by one">
						<span class="cs__lbl">Exhaustion</span>
						<input type="number" id="cs-exhaustion" min="0" max="6" value="0" class="ve-form-control ve-input-xs cs__ipt-num cs__ipt-num--xs">
						<span class="ve-muted ve-small ve-ml-2" id="cs-exhaustion-note"><!-- populated by JS --></span>
					</label>
					<div class="cs__conditions ve-flex ve-flex-wrap" id="cs-conditions"><!-- populated by JS --></div>
				</div>
			</div>

			<!-- On paper this column starts a fresh page: everything before it is what a turn needs,
				everything in it is reference (see `cs__col--reference` in the print styles) -->
			<div class="ve-col-4 cs__col cs__col--reference">
				<div class="cs__panel">
					<h5 class="cs__panel-title">Species</h5>
					<div id="cs-species-panel"><!-- populated by JS --></div>
				</div>
				<div class="cs__panel">
					<h5 class="cs__panel-title">Background</h5>
					<div id="cs-background-panel"><!-- populated by JS --></div>
				</div>
				<div class="cs__panel">
					<h5 class="cs__panel-title">Class &amp; Leveling</h5>
					<div id="cs-class-panel"><!-- populated by JS --></div>
				</div>
				<div class="cs__panel">
					<h5 class="cs__panel-title" id="cs-title-features">Features &amp; Traits</h5>
					<div id="cs-trait-list" class="ve-mb-1"><!-- populated by JS --></div>
					<textarea id="cs-features" aria-labelledby="cs-title-features" class="ve-form-control cs__textarea cs__textarea--lg" placeholder="Class features, species traits, feats..."></textarea>
				</div>
				<div class="cs__panel">
					<h5 class="cs__panel-title" id="cs-title-equipment">Equipment</h5>
					<div id="cs-inventory"><!-- populated by JS --></div>
					<textarea id="cs-equipment" aria-labelledby="cs-title-equipment" class="ve-form-control cs__textarea cs__textarea--md" placeholder="Equipment notes..."></textarea>
					<div class="cs__currency">
						<label class="cs__coin"><span class="cs__lbl">CP</span><input type="number" id="cs-cp" min="0" value="0" class="ve-form-control ve-input-xs cs__ipt-num"></label>
						<label class="cs__coin"><span class="cs__lbl">SP</span><input type="number" id="cs-sp" min="0" value="0" class="ve-form-control ve-input-xs cs__ipt-num"></label>
						<label class="cs__coin"><span class="cs__lbl">EP</span><input type="number" id="cs-ep" min="0" value="0" class="ve-form-control ve-input-xs cs__ipt-num"></label>
						<label class="cs__coin"><span class="cs__lbl">GP</span><input type="number" id="cs-gp" min="0" value="0" class="ve-form-control ve-input-xs cs__ipt-num"></label>
						<label class="cs__coin"><span class="cs__lbl">PP</span><input type="number" id="cs-pp" min="0" value="0" class="ve-form-control ve-input-xs cs__ipt-num"></label>
					</div>
				</div>
				<div class="cs__panel">
					<h5 class="cs__panel-title">Defenses &amp; Senses</h5>
					<div id="cs-defense-list"><!-- populated by JS --></div>
				</div>

				<div class="cs__panel">
					<h5 class="cs__panel-title" id="cs-title-proficiencies">Other Proficiencies &amp; Languages</h5>
					<div id="cs-prof-list" class="ve-mb-1"><!-- populated by JS --></div>
					<textarea id="cs-proficiencies" aria-labelledby="cs-title-proficiencies" class="ve-form-control cs__textarea cs__textarea--md" placeholder="Armor, weapons, tools, languages..."></textarea>
				</div>
				<div class="cs__panel">
					<h5 class="cs__panel-title">Appearance</h5>
					<div id="cs-appearance"><!-- populated by JS --></div>
				</div>

				<div class="cs__panel">
					<h5 class="cs__panel-title" id="cs-title-personality">Personality, Ideals, Bonds &amp; Flaws</h5>
					<textarea id="cs-personality" aria-labelledby="cs-title-personality" class="ve-form-control cs__textarea cs__textarea--md" placeholder="Roleplay notes, backstory, appearance..."></textarea>
				</div>
			</div>
		</div>
	</form>

	<!-- Built on demand by the Cards button; only ever visible on paper -->
	<div id="cs-cards" class="cs__cards"></div>
</main>

{{> "adFooter" }}

{{> "scripts" }}

</body>
</html>
