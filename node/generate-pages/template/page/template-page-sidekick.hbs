<!DOCTYPE html>
<html lang="en">

{{> "head" }}

<body>

{{> "overlayNoise" }}

{{> "adLeaderboard" }}

{{> "navbar" }}

{{> "adLhsScrollingPage" }}
{{> "adRhsScrollingPage" }}

<main class="container cs__page--sidekick" data-cancer-id="cancer-wrapper">
	<div class="cs__toolbar ve-flex-v-center ve-flex-wrap ve-mb-2 no-print">
		<select id="cs-char-select" class="ve-form-control ve-input-xs cs__char-select no-print" title="Switch sidekick" style="max-width: 200px; display: inline-block; width: auto;"></select>
		<button class="ve-btn ve-btn-sm ve-btn-default" id="cs-char-new" type="button" title="New sidekick"><span class="glyphicon glyphicon-plus"></span></button>
		<button class="ve-btn ve-btn-sm ve-btn-danger" id="cs-char-delete" type="button" title="Delete this sidekick"><span class="glyphicon glyphicon-trash"></span></button>
		<button class="ve-btn ve-btn-sm ve-btn-primary" id="cs-btn-print" type="button" title="Print, or save as PDF, as a stat-block card"><span class="glyphicon glyphicon-print"></span> Print / PDF</button>
		<button class="ve-btn ve-btn-sm ve-btn-default" id="cs-btn-save" type="button" title="Save this sidekick to a file"><span class="glyphicon glyphicon-download"></span> Save to File</button>
		<button class="ve-btn ve-btn-sm ve-btn-default" id="cs-btn-load" type="button" title="Load a sidekick from a file"><span class="glyphicon glyphicon-upload"></span> Load from File</button>
		<button class="ve-btn ve-btn-sm ve-btn-danger" id="cs-btn-reset" type="button" title="Clear this sidekick"><span class="glyphicon glyphicon-refresh"></span> Reset</button>
			<button class="ve-btn ve-btn-sm ve-btn-default" id="cs-btn-homebrew" type="button" title="Add or remove homebrew; brew content then appears in every picker on this page"><span class="glyphicon glyphicon-folder-open"></span> Homebrew</button>
		<a href="charactersheet.html" class="ve-btn ve-btn-sm ve-btn-default ve-ml-auto" title="Open the character sheet"><span class="glyphicon glyphicon-th-list"></span> Character Sheet</a>
	</div>

	<div class="cs__toolbar-note ve-muted ve-small ve-mb-2 no-print">Pick a sidekick type &mdash; Expert, Spellcaster or Warrior &mdash; or start from any stat block in the bestiary. Then change anything you like: nothing here is locked.</div>

	<form id="charsheet" autocomplete="off">
		<div class="cs__hdr row ve-flex">
			<div class="ve-col-4 cs__hdr-name">
				<label class="cs__lbl" for="cs-name">Sidekick Name</label>
				<input type="text" id="cs-name" class="ve-form-control cs__ipt-name" placeholder="Sidekick Name">
				<div class="ve-muted ve-small" id="cs-sk-subtitle"><!-- populated by JS --></div>
			</div>
			<div class="ve-col-8">
				<div class="cs__hdr-grid">
					<label class="cs__field no-print">
						<span class="cs__lbl">Sidekick Type</span>
						<select id="cs-sk-type" class="ve-form-control ve-input-xs" title="The Essentials Kit's three sidekicks"><!-- populated by JS --></select>
					</label>
					<label class="cs__field no-print cs__field--role ve-hidden" id="cs-sk-role-field">
						<span class="cs__lbl" id="cs-sk-role-lbl">Specialisation</span>
						<select id="cs-sk-role" class="ve-form-control ve-input-xs"><!-- populated by JS --></select>
					</label>
					<label class="cs__field cs__field--inline" title="A sidekick's level is normally the party's average level">
						<span class="cs__lbl">Level</span>
						<input type="number" id="cs-level" min="1" max="20" value="1" class="ve-form-control ve-input-xs cs__ipt-num">
					</label>
					<div class="cs__field">
						<label class="cs__lbl" for="cs-species">Base Creature</label> <span class="cs__pick-link" id="cs-link-species"></span>
						<div class="cs__pick-group">
							<input type="text" id="cs-species" class="ve-form-control ve-input-xs" placeholder="e.g. Guard">
							<button type="button" class="ve-btn ve-btn-xs ve-btn-default cs__pick-btn" id="cs-pick-creature" title="Choose any stat block to build from"><span class="glyphicon glyphicon-search"></span></button>
						</div>
					</div>
					<label class="cs__field no-print" title="Tasha's sidekick classes — an alternative to the Essentials Kit types, and the way to take a sidekick past 6th level">
						<span class="cs__lbl">Sidekick Class <span class="ve-muted">(Tasha's)</span></span>
						<select id="cs-sk-class" class="ve-form-control ve-input-xs"><!-- populated by JS --></select>
					</label>
				</div>
				<div class="ve-muted ve-small no-print" id="cs-sk-role-hint"><!-- populated by JS --></div>
			</div>
		</div>

		<hr>

		<div class="row ve-flex cs__body">
			<div class="ve-col-3 cs__col">
				<div class="cs__panel">
					<h5 class="cs__panel-title">Ability Scores</h5>
					<div class="cs__abilities" id="cs-abilities"><!-- populated by JS --></div>
					<div id="cs-ability-offers"><!-- populated by JS --></div>
				</div>

				<div class="cs__panel cs__panel--inline">
					<div class="cs__stat-badge" title="Proficiency Bonus (from the sidekick's level)">
						<span class="cs__stat-badge-val" id="cs-pb">+2</span>
						<span class="cs__lbl">Proficiency Bonus</span>
					</div>
					<div class="cs__stat-badge" title="10 + Wisdom (Perception) modifier">
						<span class="cs__stat-badge-val" id="cs-passive-perception">10</span>
						<span class="cs__lbl">Passive Perception</span>
					</div>
				</div>

				<div class="cs__panel">
					<h5 class="cs__panel-title">Saving Throws</h5>
					<div class="cs__list" id="cs-saves"><!-- populated by JS --></div>
				</div>

				<div class="cs__panel">
					<h5 class="cs__panel-title">Skills</h5>
					<div class="cs__list" id="cs-skills"><!-- populated by JS --></div>
				</div>
			</div>

			<div class="ve-col-5 cs__col">
				<div class="cs__panel">
					<div class="cs__combat-top">
						<label class="cs__field cs__field--boxed" title="Set this to whatever the sidekick's armour and features add up to">
							<span class="cs__lbl">Armor Class</span>
							<input type="number" id="cs-ac" min="0" value="10" class="ve-form-control ve-input-xs cs__ipt-num cs__ipt-fill">
						</label>
						<div class="cs__field cs__field--boxed" title="1d20 + Dexterity modifier + misc">
							<span class="cs__lbl">Initiative</span>
							<div class="cs__combat-init">
								<span id="cs-initiative-roll" class="cs__roll">+0</span>
								<label class="cs__init-misc" title="Miscellaneous initiative bonus">+<input type="number" id="cs-init-misc" value="0" class="ve-form-control ve-input-xs cs__ipt-num cs__ipt-num--xs"></label>
							</div>
						</div>
						<label class="cs__field cs__field--boxed"><span class="cs__lbl">Speed</span><input type="text" id="cs-speed" value="30 ft." class="ve-form-control ve-input-xs cs__ipt-fill"></label>
					</div>

					<div class="cs__hp">
						<div class="cs__hp-main">
							<div class="cs__hp-row">
								<label class="cs__field cs__field--boxed"><span class="cs__lbl">Current HP</span><input type="number" id="cs-hp-cur" value="0" class="ve-form-control ve-input-xs cs__ipt-num cs__ipt-num--hp"></label>
								<label class="cs__field cs__field--boxed"><span class="cs__lbl">Max HP</span><input type="number" id="cs-hp-max" min="0" value="0" class="ve-form-control ve-input-xs cs__ipt-num cs__ipt-num--hp"></label>
								<label class="cs__field cs__field--boxed"><span class="cs__lbl">Temp HP</span><input type="number" id="cs-hp-temp" value="0" class="ve-form-control ve-input-xs cs__ipt-num cs__ipt-num--hp"></label>
							</div>
							<div class="cs__hp-quick ve-flex-v-center ve-flex-wrap no-print">
								<label class="cs__field cs__field--inline ve-mb-0"><span class="cs__lbl">Adjust</span><input type="number" id="cs-hp-delta" value="0" class="ve-form-control ve-input-xs cs__ipt-num cs__ipt-num--xs"></label>
								<button type="button" id="cs-hp-damage" class="ve-btn ve-btn-xs ve-btn-danger" title="Subtract from current HP">Damage</button>
								<button type="button" id="cs-hp-heal" class="ve-btn ve-btn-xs ve-btn-success" title="Add to current HP">Heal</button>
								<span class="ve-muted ve-small ve-ml-2" id="cs-sk-hp-hint"><!-- populated by JS --></span>
							</div>
							<div class="cs__hp-rests ve-flex-v-center ve-flex-wrap no-print">
								<button type="button" id="cs-short-rest" class="ve-btn ve-btn-xs ve-btn-default" title="Restore Pact Magic slots">Short Rest</button>
								<button type="button" id="cs-long-rest" class="ve-btn ve-btn-xs ve-btn-primary" title="Restore HP, spell slots and Hit Dice">Long Rest</button>
							</div>
						</div>
						<div class="cs__hp-side">
							<div class="cs__hd">
								<span class="cs__lbl">Hit Dice</span>
								<div class="cs__hd-row">
									<label class="cs__field"><span class="cs__lbl cs__lbl--sub">Remaining</span><input type="text" id="cs-hd-cur" placeholder="e.g. 4d8" class="ve-form-control ve-input-xs"></label>
									<label class="cs__field"><span class="cs__lbl cs__lbl--sub">Total</span><input type="text" id="cs-hd-total" placeholder="e.g. 4d8" class="ve-form-control ve-input-xs"></label>
								</div>
							</div>
							<div class="cs__death">
								<span class="cs__lbl">Death Saves</span>
								<div class="cs__death-row"><span class="cs__death-lbl">Successes</span><span class="cs__death-dots" id="cs-death-success" data-cs-max="3"></span></div>
								<div class="cs__death-row"><span class="cs__death-lbl">Failures</span><span class="cs__death-dots" id="cs-death-fail" data-cs-max="3"></span></div>
							</div>
						</div>
					</div>
				</div>

				<div class="cs__panel">
					<div class="cs__panel-title-row ve-flex-v-center ve-flex-h-between">
						<h5 class="cs__panel-title ve-mb-0">Attacks</h5>
						<div class="ve-flex-v-center no-print">
							<button type="button" id="cs-attack-add-weapon" class="ve-btn ve-btn-xs ve-btn-default ve-mr-2" title="Add a row from a weapon in the data"><span class="glyphicon glyphicon-search"></span> Add Weapon</button>
							<button type="button" id="cs-attack-add" class="ve-btn ve-btn-xs ve-btn-default" title="Add a blank row"><span class="glyphicon glyphicon-plus"></span> Add</button>
						</div>
					</div>
					<table class="cs__attacks w-100">
						<thead>
							<tr>
								<th>Name</th>
								<th class="ve-text-center">Atk Bonus</th>
								<th class="ve-text-center">Damage/Type</th>
								<th class="ve-text-center no-print"></th>
							</tr>
						</thead>
						<tbody id="cs-attacks-body"><!-- populated by JS --></tbody>
					</table>
					<div class="ve-muted ve-small ve-mt-1 no-print">The stat block's own attacks are listed under Traits &amp; Actions; add them here to roll them.</div>
				</div>

				<div class="cs__panel">
					<div class="cs__panel-title-row ve-flex-v-center ve-flex-h-between">
						<h5 class="cs__panel-title ve-mb-0">Traits &amp; Actions</h5>
						<div class="ve-flex-v-center no-print">
							<button type="button" id="cs-sk-trait-add" class="ve-btn ve-btn-xs ve-btn-default" title="Add a trait, action, bonus action or reaction"><span class="glyphicon glyphicon-plus"></span> Add</button>
						</div>
					</div>
					<div id="cs-sk-traits"><!-- populated by JS --></div>
					<textarea id="cs-features" aria-label="Other notes" class="ve-form-control cs__textarea cs__textarea--md ve-mt-2" placeholder="Anything else worth noting..."></textarea>
				</div>

				<div class="cs__panel">
					<h5 class="cs__panel-title">Conditions &amp; Notes</h5>
					<label class="cs__field cs__field--inline ve-mb-1">
						<span class="cs__lbl">Concentrating on</span>
						<input type="text" id="cs-concentration" class="ve-form-control ve-input-xs" placeholder="e.g. Bless">
					</label>
					<div id="cs-conc-prompt" class="cs__conc-prompt ve-hidden no-print"><!-- populated by JS --></div>
					<label class="cs__field cs__field--inline ve-mb-1" title="0–6; a long rest reduces it by one">
						<span class="cs__lbl">Exhaustion</span>
						<input type="number" id="cs-exhaustion" min="0" max="6" value="0" class="ve-form-control ve-input-xs cs__ipt-num cs__ipt-num--xs">
						<span class="ve-muted ve-small ve-ml-2" id="cs-exhaustion-note"><!-- populated by JS --></span>
					</label>
					<div class="cs__conditions ve-flex ve-flex-wrap" id="cs-conditions"><!-- populated by JS --></div>
					<textarea id="cs-personality" aria-label="Who this sidekick is" class="ve-form-control cs__textarea cs__textarea--md ve-mt-2" placeholder="Who is this sidekick? Loyalties, quirks, who controls it..."></textarea>
				</div>
			</div>

			<div class="ve-col-4 cs__col">
				<div class="cs__panel no-print" id="cs-sk-levelling">
					<div class="cs__panel-title-row ve-flex-v-center ve-flex-h-between">
						<h5 class="cs__panel-title ve-mb-0">Levelling Up</h5>
						<button type="button" id="cs-sk-rules-toggle" class="ve-btn ve-btn-xxs ve-btn-default no-print" title="Show the full rules from the book">Full rules</button>
					</div>
					<div id="cs-sk-level-next" class="ve-mb-2"><!-- populated by JS --></div>
					<div id="cs-sk-level-table"><!-- populated by JS --></div>
					<div id="cs-sk-rules" class="ve-hidden ve-small ve-mt-2"><!-- populated by JS --></div>
				</div>

				<div class="cs__panel" id="cs-sk-class-panel-wrp">
					<h5 class="cs__panel-title">Class Features by Level</h5>
					<div id="cs-class-panel"><!-- populated by JS --></div>
				</div>

				<div class="cs__panel">
					<div class="cs__panel-title-row ve-flex-v-center ve-flex-h-between no-print">
						<span class="cs__lbl ve-mb-0" id="cs-title-spells">Spells</span>
						<div class="ve-flex-v-center no-print">
							<button type="button" id="cs-spell-browse" class="ve-btn ve-btn-xs ve-btn-primary ve-mr-2" title="Browse this class's learnable spells"><span class="glyphicon glyphicon-book"></span> Class Spells</button>
							<button type="button" id="cs-spell-add" class="ve-btn ve-btn-xs ve-btn-default" title="Search and add any spell"><span class="glyphicon glyphicon-search"></span> Add Spell</button>
						</div>
					</div>
					<div id="cs-spell-body">
						<div class="cs__spellhdr">
							<label class="cs__field cs__field--inline">
								<span class="cs__lbl">Spellcasting Ability</span>
								<select id="cs-spell-ability" class="ve-form-control ve-input-xs">
									<option value="">&mdash;</option>
									<option value="int">Intelligence</option>
									<option value="wis">Wisdom</option>
									<option value="cha">Charisma</option>
								</select>
							</label>
							<div class="cs__stat-badge" title="8 + proficiency bonus + spellcasting ability modifier">
								<span class="cs__stat-badge-val" id="cs-spell-dc">&mdash;</span>
								<span class="cs__lbl">Spell Save DC</span>
							</div>
							<div class="cs__stat-badge" title="proficiency bonus + spellcasting ability modifier">
								<span class="cs__stat-badge-val cs__roll" id="cs-spell-atk">&mdash;</span>
								<span class="cs__lbl">Spell Attack Bonus</span>
							</div>
						</div>
						<div id="cs-spell-slots" class="ve-mt-1"><!-- populated by JS --></div>
						<div id="cs-spells-known" class="ve-mt-1"><!-- populated by JS --></div>
						<textarea id="cs-spells" aria-labelledby="cs-title-spells" class="ve-form-control cs__textarea cs__textarea--md" placeholder="Spell notes..."></textarea>
					</div>
				</div>

				<div class="cs__panel">
					<h5 class="cs__panel-title" id="cs-title-equipment">Equipment</h5>
					<div id="cs-inventory"><!-- populated by JS --></div>
					<textarea id="cs-equipment" aria-labelledby="cs-title-equipment" class="ve-form-control cs__textarea cs__textarea--md" placeholder="Gear, treasure..."></textarea>
				</div>

				<div class="cs__panel">
					<h5 class="cs__panel-title">Defenses &amp; Senses</h5>
					<div id="cs-defense-list"><!-- populated by JS --></div>
				</div>

				<div class="cs__panel">
					<h5 class="cs__panel-title" id="cs-title-proficiencies">Other Proficiencies &amp; Senses</h5>
					<div id="cs-prof-list" class="ve-mb-1"><!-- populated by JS --></div>
					<textarea id="cs-proficiencies" aria-labelledby="cs-title-proficiencies" class="ve-form-control cs__textarea cs__textarea--md" placeholder="Senses, languages, armor, weapons, tools..."></textarea>
				</div>
			</div>
		</div>
	</form>
</main>

{{> "adFooter" }}

{{> "scripts" }}

</body>
</html>
